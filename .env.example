# Sao chép file này thành .env và điền key thật.
# Có thể nhập NHIỀU key (phân tách bởi dấu phẩy) để tự xoay khi hết credit/lỗi:
#   SERPER_API_KEY=key1,key2,key3
SERPER_API_KEY=your_serper_api_key_here

# Google locale cho Serper (site mục tiêu là tiếng Việt)
SERPER_GL=vn
SERPER_HL=vi

# Tuỳ chọn
HTTP_TIMEOUT=20
MAX_WORKERS=8
CACHE_DIR=.cache

# ---- Khi DEPLOY WEB (Streamlit Cloud → Secrets) ----
# APP_PASSWORD=mat-khau-cua-ban   # khóa truy cập; bỏ trống = không khóa (chỉ nên khi chạy local)
# SERPER_API_KEY dùng chung: đặt trong Secrets là mọi người xài chung, khỏi nhập lại
